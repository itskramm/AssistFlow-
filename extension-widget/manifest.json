{
  "manifest_version": 3,
  "name": "AssistFlow Assistant",
  "version": "1.0.0",
  "description": "AI-powered workplace support assistant accessible from any webpage",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://assistflow-backend-ctbq.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["widget.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["iframe.html", "icons/*.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
