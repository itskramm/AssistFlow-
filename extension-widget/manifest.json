{
  "manifest_version": 3,
  "name": "AssistFlow Assistant",
  "version": "2.0.0",
  "description": "AI-powered workplace support assistant with Chrome side panel",
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel"
  ],
  "host_permissions": [
    "https://assistflow-backend-ctbq.onrender.com/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open AssistFlow Assistant"
  },
  "background": {
    "service_worker": "background.js"
  }
}
